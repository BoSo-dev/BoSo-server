APP_ENV=development
# Local PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql+psycopg://boso:boso-local@localhost:5432/boso
# Supabase: copy the Direct or Session pooler URI from Dashboard > Connect.
# postgres:// and postgresql:// are normalized to postgresql+psycopg://.
# Remote PostgreSQL defaults to sslmode=require; disable/allow/prefer are rejected.
# Set host/port in the URI authority, not host/hostaddr/port query options.
# URL-encode the actual DB password. Do not keep placeholder brackets.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Optional Alembic connection. If omitted, DATABASE_URL is used.
# Leave this line commented out when not needed; do not set an empty value.
# Use Direct or Session pooler for migrations, not transaction pooler port 6543.
# Keep migration credentials separate from the least-privilege runtime account.
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Application pool: size 1..20, extra connections 0..20, timeouts in seconds 1..60.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_CONNECT_TIMEOUT=5
DB_POOL_TIMEOUT=10
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Optional test-only PostgreSQL. Never use the real Supabase database here.
# TEST_DATABASE_URL=postgresql+psycopg://boso:boso-local@localhost:5432/boso_test
# Export TEST_DATABASE_URL in the test process; pytest does not load it from .env.
# Only used by the local Compose database. Do not use this password remotely.
POSTGRES_USER=boso
POSTGRES_PASSWORD=boso-local
POSTGRES_DB=boso
