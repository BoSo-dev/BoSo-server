APP_ENV=development
# Local PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql+psycopg://boso:boso-local@localhost:5432/boso
# Supabase: copy the Direct or Session pooler URI from Dashboard > Connect.
# Change postgresql:// to postgresql+psycopg:// and append ?sslmode=require.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Only used by the local Compose database. Do not use this password remotely.
POSTGRES_USER=boso
POSTGRES_PASSWORD=boso-local
POSTGRES_DB=boso
